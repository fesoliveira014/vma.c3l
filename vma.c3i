extern fn vk::Result Allocator.create_aliasing_image2(self, Allocation allocation, vk::DeviceSize offset, vk::ImageCreateInfo* ii, vk::Image* out_image) @cname("vmaCreateAliasingImage2");
extern fn vk::Result Allocator.create_buffer_with_alignment(self, vk::BufferCreateInfo* bi, AllocationCreateInfo* ci, vk::DeviceSize min_alignment, vk::Buffer* out_buffer, Allocation* out_alloc, AllocationInfo* out_info) @cname("vmaCreateBufferWithAlignment");
extern fn vk::Result Allocator.allocate_memory_pages(self, vk::MemoryRequirements* reqs, AllocationCreateInfo* cis, usz count, Allocation* out_allocs, AllocationInfo* out_infos) @cname("vmaAllocateMemoryPages");
extern fn void Allocator.free_memory_pages(self, usz count, Allocation* allocations) @cname("vmaFreeMemoryPages");

extern fn void VirtualBlock.destroy(self) @cname("vmaDestroyVirtualBlock");
extern fn vk::Bool32 VirtualBlock.is_empty(self) @cname("vmaIsVirtualBlockEmpty");
